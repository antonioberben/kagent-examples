# Copy to .env and fill in your provider key. .env is gitignored; this file is not.
#
#   cp .env.example .env
#   $EDITOR .env
#   set -a && source .env && set +a
#
# This file is the single source of truth for the lab's versions. test.sh asserts
# that the manifests agree with it, so bumping a version here and forgetting the
# manifest is a test failure rather than a surprise at runtime.
#
# The judge needs no credentials: it runs in your cluster.

# --- the one secret ----------------------------------------------------------
# Key for the provider that GENERATES. This is the only value that must never
# be committed, pasted into a manifest, or typed on a command line.
OPENAI_API_KEY=

# --- cluster -----------------------------------------------------------------
CLUSTER_NAME=judge
KUBE_CONTEXT=kind-judge
NAMESPACE=agentgateway-system

# --- versions ----------------------------------------------------------------
# Everything is pinned. Nothing here is a rolling tag, so a run today and a run
# in six months install the same bits. Check for newer stable releases with:
#
#   gh release list --repo kubernetes-sigs/gateway-api --exclude-pre-releases
#   gh release list --repo agentgateway/agentgateway  --exclude-pre-releases
#   gh release list --repo ollama/ollama              --exclude-pre-releases
#
GATEWAY_API_VERSION=v1.6.1
# agentgateway chart and appVersion move together, so one value covers both.
AGENTGATEWAY_VERSION=1.4.1

# --- images ------------------------------------------------------------------
# Pinned in manifests/01 and manifests/03 as well. test.sh checks they match.
OLLAMA_IMAGE=ollama/ollama:0.32.15
JUDGE_RUNTIME_IMAGE=python:3.12.12-slim

# --- models ------------------------------------------------------------------
# The generator stays remote, the judge stays in the cluster.
GENERATOR_MODEL=gpt-4o-mini
JUDGE_MODEL=qwen2.5:3b

# --- judge webhook -----------------------------------------------------------
# observe = log only | annotate = append the verdict | block = reject below THRESHOLD
MODE=observe
THRESHOLD=3
# agentgateway caps the guardrail webhook call at 10s (hard-coded in the proxy, not
# configurable from the policy), so this has to stay comfortably below that. Above it,
# the gateway gives up first, applies failureMode, and your score arrives too late to
# matter while the log still looks healthy.
JUDGE_TIMEOUT=8
# Straight to Ollama. Point it at the gateway instead (see manifests/05) if you
# want the judge's own tokens in agentgateway_gen_ai_client_token_usage:
#   http://agentgateway-proxy.agentgateway-system.svc.cluster.local/judge/v1/chat/completions
OLLAMA_URL=http://ollama.agentgateway-system.svc.cluster.local:11434/v1/chat/completions

# --- local port-forwards -----------------------------------------------------
GATEWAY_PORT=8080
JUDGE_PORT=8000
METRICS_PORT=15020
