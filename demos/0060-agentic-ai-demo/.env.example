# Copy to .env and fill in your values:  cp .env.example .env
# .env is gitignored — never commit real keys.

# Kube context for the target cluster.
export KUBE_CONTEXT=<your-kube-context>

# Secrets. Either paste the values here, or export them in your shell and
# reference them (e.g. export OPENAI_API_KEY=$OPENAI_API_KEY) so they stay out
# of the file.
export OPENAI_API_KEY=<your-openai-api-key>
export SOLO_ISTIO_LICENSE_KEY=<your-solo-istio-license-key>
export GLOO_GATEWAY_LICENSE_KEY=<your-gloo-gateway-license-key>
export AGENTGATEWAY_LICENSE_KEY=<your-agentgateway-license-key>

# Pinned versions / registries (reproducible demos).
export ISTIO_VERSION=1.30.0
export ISTIO_IMAGE_TAG=1.30.0-solo
export ISTIO_REPO=us-docker.pkg.dev/soloio-img/istio
export ISTIO_HELM_REPO=us-docker.pkg.dev/soloio-img/istio-helm
export AGENTGATEWAY_VERSION=v2026.5.2
export KAGENT_ENT_VERSION=0.4.4
export AGENTREGISTRY_VERSION=0.3.3
export GATEWAY_API_VERSION=v1.2.1
# OpenClaw harness backend: NVIDIA OpenShell gateway + upstream agent-sandbox CRDs.
export OPENSHELL_VERSION=0.0.55
export AGENT_SANDBOX_VERSION=v0.4.6
